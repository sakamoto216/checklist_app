{
  "expo": {
    "name": "Nest List",
    "slug": "nest-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DA7B39"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kouhei-sakamoto.nestlist",
